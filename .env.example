# Copy to .env.local. Everything is optional: the app runs fully without any of these.

# Shared secret for signing device readings (ESP32 firmware and scripts/device-sim.mjs must use the same value)
DEVICE_SECRET=gramsatya-demo-secret

# AI insights. Leave all empty to use the built-in rules (offline, free).
# Pick one provider:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# AI_PROVIDER=openai          # any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
